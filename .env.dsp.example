# Cadence DSP 开发环境配置示例
# 复制此文件为 .env 并修改为实际值
# cp .env.dsp.example .env

# ============================================
# Cadence Xtensa 工具链配置
# ============================================

# Xtensa Core 名称
# 必须与工具链中 config/ 目录下的 core 名称匹配
XTENSA_CORE=my_dsp_core

# ============================================
# 许可证配置（二选一）
# ============================================

# 选项 1: 网络许可证服务器
# 格式: port@hostname 或 port@ip_address
LM_LICENSE_FILE=27000@license-server.example.com
# LM_LICENSE_FILE=27000@192.168.1.100

# 选项 2: 本地许可证文件
# LM_LICENSE_FILE=/opt/licenses/cadence.dat

# ============================================
# 工具链路径（可选，默认在 Docker 内部）
# ============================================

# Cadence 工具链根目录（宿主机路径）
# 用于 Docker volume 挂载
HOST_XTENSA_TOOLS=/opt/cadence/xtensa/XtDevTools

# 容器内工具链路径（通常不需要修改）
XTENSA_TOOLS_ROOT=/opt/toolchains/xtensa

# ============================================
# 编译选项
# ============================================

# 优化级别
CFLAGS=-O2

# 调试信息
# CFLAGS=-g -O0

# ============================================
# 项目特定配置
# ============================================

# eRPC 构建选项
# CONFIG_ERPC_TESTS=y
# CONFIG_ERPC_EXAMPLES=y
